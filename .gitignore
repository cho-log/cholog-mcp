# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/
.pytest_cache/

# 데이터: 수집한 원본과 SQLite 파일은 올리지 않는다 (수집 스크립트로 다시 만든다)
data/*
!data/.gitkeep

# 환경 설정, 로그
.env
*.log

# OS, 에디터
.DS_Store
.idea/
.vscode/

# AI 도구의 개인 설정
.claude/settings.local.json

# Terraform: state(실제 자원과의 대응표)와 개인 값(tfvars)은 올리지 않는다
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/terraform.tfvars
infra/.build/
